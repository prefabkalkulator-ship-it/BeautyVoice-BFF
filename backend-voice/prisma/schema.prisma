// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String         @id @default(uuid())
  name                String
  phoneNumber         String         @unique
  assignedPhoneNumber String?        @unique // Wirtualny numer SIP dla tego salonu
  businessProfile     String         @default("solo")
  bookingMode         String         @default("hourly")
  aiVoice             String         @default("Aoede")
  botName             String         @default("Ewa")
  toneOfVoice         String         @default("profesjonalny i przyjazny")
  pinCode             String?
  termsAcceptedAt     DateTime?
  fcmTokens           String[]
  createdAt           DateTime       @default(now())
  
  services            Service[]
  faqEntries      FaqEntry[]
  appointments    Appointment[]
  callLogs        CallLog[]
  staffMembers    StaffMember[]
  resources       Resource[]
  subscription    Subscription?
  timeOffs        TimeOff[]
  customers       Customer[]
  campaigns       Campaign[]
  outboundQueues  OutboundQueue[]
}

model Subscription {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planName             String   @default("free")
  minutesIncluded      Int      @default(100)
  minutesUsed          Int      @default(0)
  aiGenerationsUsed    Int      @default(0)
  status               String   @default("active")
  pausedAt             DateTime?
  pausedUntil          DateTime?
  canceledAt           DateTime?
  currentPeriodEnd     DateTime?
  
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StaffMember {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  role         String?
  isActive     Boolean        @default(true)
  schedule     Json?
  
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     StaffService[]
  appointments Appointment[]
  timeOffs     TimeOff[]
}

model Resource {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  type         String?
  
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Service {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  price           Float
  durationMinutes Int
  description     String?
  
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  staffMembers    StaffService[]
}

model StaffService {
  staffId   String
  serviceId String
  
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@id([staffId, serviceId])
}

model FaqEntry {
  id       String  @id @default(uuid())
  tenantId String
  question String
  answer   String
  category String?
  
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String       @id @default(uuid())
  tenantId      String
  serviceId     String
  staffId       String?
  resourceId    String?
  customerId    String?
  customerName  String
  customerPhone String
  startTime     DateTime
  endTime       DateTime
  status        String       @default("confirmed") // confirmed, cancelled
  
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resource      Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model CallLog {
  id              String   @id @default(uuid())
  tenantId        String
  callerPhone     String
  durationSeconds Int
  status          String
  transcript      String?  @db.Text
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TimeOff {
  id           String       @id @default(uuid())
  tenantId     String
  staffId      String?
  startDate    DateTime
  endDate      DateTime
  reason       String?
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
}


model Customer {
  id            String        @id @default(uuid())
  tenantId      String
  name          String
  phone         String
  tags          String[]
  notes         String?       @db.Text
  lastVisitAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  campaignLogs  CampaignLog[]
}

model Campaign {
  id             String        @id @default(uuid())
  tenantId       String
  name           String
  type           String        // 'sms' | 'voice'
  status         String        // 'draft' | 'scheduled' | 'running' | 'completed'
  messageContent String        @db.Text
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs           CampaignLog[]
}

model CampaignLog {
  id         String    @id @default(uuid())
  campaignId String
  customerId String
  status     String    // 'pending' | 'sent' | 'failed'
  sentAt     DateTime?

  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model OutboundQueue {
  id             String    @id @default(uuid())
  tenantId       String
  targetPhone    String
  channel        String    // 'sms' | 'voice'
  payload        Json
  status         String    // 'pending' | 'processing' | 'done' | 'failed'
  scheduledFor   DateTime
  processedAt    DateTime?
  errorMessage   String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
