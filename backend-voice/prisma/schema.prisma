// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String         @id @default(uuid())
  name            String
  phoneNumber     String         @unique
  businessProfile String         @default("solo") // solo, team, facility
  bookingMode     String         @default("hourly") // hourly, daily
  aiVoice         String         @default("Aoede") // Aoede, Kore, Puck, Charon
  createdAt       DateTime       @default(now())
  
  services        Service[]
  faqEntries      FaqEntry[]
  appointments    Appointment[]
  callLogs        CallLog[]
  staffMembers    StaffMember[]
  resources       Resource[]
  subscription    Subscription?
  timeOffs        TimeOff[]
}

model Subscription {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planName             String   @default("free")
  minutesIncluded      Int      @default(100)
  minutesUsed          Int      @default(0)
  aiGenerationsUsed    Int      @default(0)
  status               String   @default("active")
  
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StaffMember {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  role         String?
  isActive     Boolean        @default(true)
  schedule     Json?
  
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     StaffService[]
  appointments Appointment[]
  timeOffs     TimeOff[]
}

model Resource {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  type         String?
  
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Service {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  price           Float
  durationMinutes Int
  description     String?
  
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  staffMembers    StaffService[]
}

model StaffService {
  staffId   String
  serviceId String
  
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@id([staffId, serviceId])
}

model FaqEntry {
  id       String  @id @default(uuid())
  tenantId String
  question String
  answer   String
  category String?
  
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String       @id @default(uuid())
  tenantId      String
  serviceId     String
  staffId       String?
  resourceId    String?
  customerName  String
  customerPhone String
  startTime     DateTime
  endTime       DateTime
  status        String       @default("confirmed") // confirmed, cancelled
  
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resource      Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
}

model CallLog {
  id              String   @id @default(uuid())
  tenantId        String
  callerPhone     String
  durationSeconds Int
  status          String
  transcript      String?  @db.Text
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TimeOff {
  id           String       @id @default(uuid())
  tenantId     String
  staffId      String?
  startDate    DateTime
  endDate      DateTime
  reason       String?
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
}
