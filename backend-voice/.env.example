# ==========================================
# BEAUTYVOICE-BFF - ENVIRONMENT VARIABLES
# ==========================================

# 1. Port Serwera
PORT=8080

# 2. Baza Danych (Supabase PostgreSQL)
# Dla środowiska DEV zalecany jest osobny projekt Supabase lub dodanie parametru ?schema=dev
DATABASE_URL="postgresql://postgres.[PROJ_ID]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJ_ID]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# 3. Model Językowy Google Gemini
GEMINI_API_KEY="AIzaSy..."

# 4. Telefonia Zadarma (SMS i SIP)
ZADARMA_KEY="your_zadarma_key"
ZADARMA_SECRET="your_zadarma_secret"
ZADARMA_PHONE_NUMBER="48459568507"

# 5. Telefonia Twilio (Media Stream Audio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_CALLER_ID="+1..."

# 6. Poczta E-mail Transakcyjna (SMTP GoDaddy / Secureserver)
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@veritas-app.com"
SMTP_PASS="your_smtp_password"
ADMIN_NOTIFICATION_EMAIL="support@veritas-app.com"

# 7. SuperAdmin & Bezpieczeństwo
SUPERADMIN_PIN="5742"
SUPERADMIN_SECRET="random_strong_secret_key_here"

# 8. Opcjonalne zmienne dla środowiska DEV (Dev Proxy)
# Jeśli chcesz lokalnie odbierać połączenia głosowe z numeru testowego przez ngrok:
# DEV_FORWARD_URL="https://your-ngrok-tunnel.ngrok-free.app"
# DEV_TEST_PHONE_NUMBER="+48459568507"
